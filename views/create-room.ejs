<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Room</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <form action="/room/create" method="post">
        <h1>Create Room</h1>
        <label for="room_number">Room Number: <input name="room_number" type="text"></label>
        <label for="capacity">Capacity: <input name="capacity" type="text"></label>
        <label for="departmentId">Department: 
            <% if (locals.departments) { %>
                <select name="departmentId">
                    <option value="">Choose Department</option>
                    <% departments.map((department) => { %>
                        <option value="<%=department.id%>"><%=department.name%></option>
                    <% }) %>
                </select>
            <% } %>
        </label>
        <div class="room-types-form">
            <p>Select Room Types: </p>
            <% if (locals.room_types) { %>
                <% room_types.map((room_type) => { %>
                    <input type="checkbox" name="room_types_ids[]" value="<%=room_type.id%>" id="roomtype-<%=room_type.id%>">
                    <label for="roomtype-<%=room_type.id%>"><%=room_type.name%></label><br>
                <% }) %>
            <% } %>
        </div>
        <button type="submit">Create Room</button>
        <a href="/">Cancel</a>
    </form>
</body>

</html>